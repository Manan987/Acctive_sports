# ---- Database ----
# Local dev uses SQLite (no setup needed). For production (Vercel) switch the
# provider in prisma/schema.prisma to "postgresql" and set a Postgres URL here.
DATABASE_URL="file:./dev.db"

# ---- Auth ----
# Secret used to sign admin session JWTs. Use a long random string in production.
# Generate one:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-please"

# Seed admin credentials (used by prisma/seed.ts to create the first admin login)
# These defaults are for LOCAL DEV ONLY — the seed refuses to use them when
# NODE_ENV=production. ADMIN_EMAIL is lower-cased before use.
ADMIN_EMAIL="admin@acctivesports.com"
ADMIN_PASSWORD="acctive@admin123"

# ---- Public site config ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="919997100375"
NEXT_PUBLIC_CONTACT_EMAIL="activesportswears@gmail.com"

# ---- Image uploads (optional in dev) ----
# In production set ONE of these so admin image uploads persist (Railway/Render
# disks are ephemeral). Left blank locally, uploads go to /public/uploads.
CLOUDINARY_URL=""          # cloudinary://api_key:api_secret@cloud_name  (recommended)
BLOB_READ_WRITE_TOKEN=""   # alternative: Vercel Blob

# ---- Payment details (optional) ----
# Shown to the customer on the order-confirmation screen. Anything left blank is
# NOT displayed — the checkout falls back to "our team will send you the payment
# details", so the site can never quote an account that doesn't exist.
# Bank details only appear when BOTH the account number and IFSC are set.
NEXT_PUBLIC_UPI_ID=""
NEXT_PUBLIC_BANK_ACCOUNT_NAME=""
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=""
NEXT_PUBLIC_BANK_IFSC=""
NEXT_PUBLIC_BANK_NAME=""

# ---- Analytics (optional) ----
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX. Leave blank to disable.
NEXT_PUBLIC_GA_ID=""
