# =====================================================================
#  PRODUCTION environment variables
#  Set these in your host's dashboard (Railway → Variables, or Render →
#  Environment). Do NOT commit real secrets to git.
# =====================================================================

# ---- Database (managed PostgreSQL: Neon / Supabase) ----
# The app auto-detects "postgres://" and switches Prisma to PostgreSQL at build
# time — no schema edits needed. Use the POOLED connection string.
DATABASE_URL="postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ---- Auth ----
# REQUIRED. Long random string. Generate:  openssl rand -base64 32
# (On Render's Blueprint this is auto-generated for you.)
AUTH_SECRET="replace-with-a-long-random-secret"

# First admin login (created by the seed script). Use a STRONG password.
# REQUIRED in production — the seed refuses to run without ADMIN_PASSWORD
# rather than silently create an account with the documented default.
# ADMIN_EMAIL is lower-cased before use.
ADMIN_EMAIL="admin@acctivesports.com"
ADMIN_PASSWORD="use-a-strong-unique-password"

# ---- Rate limiting ----
# Rate limits identify callers by the IP your proxy reports. Leave unset on
# Vercel/Render/Railway (all terminate TLS at a trusted proxy). Set to "false"
# ONLY if the app is exposed directly to the internet with no proxy in front —
# otherwise a client can spoof x-forwarded-for and bypass the limits.
# TRUST_PROXY="true"

# ---- Public site config ----
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="919997100375"
NEXT_PUBLIC_CONTACT_EMAIL="activesportswears@gmail.com"

# ---- Image uploads (Cloudinary — free, host-agnostic) ----
# Sign up at cloudinary.com → Dashboard shows the API Environment variable:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Railway/Render disks are ephemeral, so this is required for uploads to persist.
CLOUDINARY_URL=""

# ---- Analytics (optional) ----
NEXT_PUBLIC_GA_ID=""
